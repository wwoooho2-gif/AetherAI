{
  "name": "aether-chat",
  "version": "1.0.0",
  "type": "module",
  "displayName": "Aether Chat",
  "description": "A local-first AI chat and model workshop.",
  "scripts": {
    "start": "sh scripts/start-app.sh",
    "download:model": "sh scripts/download-model.sh",
    "download:model:fast": "sh scripts/download-model.sh fast",
    "download:model:coder": "sh scripts/download-model.sh coder",
    "train:setup": "sh scripts/setup-finetuning.sh",
    "ai": "sh scripts/start-llama-server.sh",
    "dev": "vite --host 127.0.0.1 --port 5175",
    "dev:game": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
